{
  "hosting": [
    {
      "site": "veplworks",
      "public": "preview",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/stack-studio.html" }],
      "headers": [
        {
          "source": "/stack-studio.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
        }
      ]
    },
    {
      "site": "veplworks-home",
      "public": "landing",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
